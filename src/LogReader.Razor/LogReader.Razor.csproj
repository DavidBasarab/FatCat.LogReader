<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>FatCat.LogReader.Razor</RootNamespace>
		<AssemblyName>FatCatLogReaderRazor</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CSharpier.MsBuild" Version="1.4.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
	</ItemGroup>
</Project>
